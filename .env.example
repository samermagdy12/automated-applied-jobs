# Public Channel invite code or complete https://whatsapp.com/channel/... URL.
CHANNEL_INVITE_CODE=0029Vb8LKeD7dmeV7rf9r338

# Directory containing the local WhatsApp multi-file session. Never commit it.
AUTH_DIR=auth

# Posts fetched after reconnect to fill a short outage window. They are printed only if newer than startup.
CATCH_UP_MESSAGE_COUNT=20

# Temporary verification: print one historical post from the configured Channel,
# then continue normal live listening. Keep false during normal operation.
TEST_MODE=false

# Temporary live-event diagnostic. Set true while publishing one test post.
NEWSLETTER_DIAGNOSTIC=false

# Pino level: silent, fatal, error, warn, info, debug, trace
LOG_LEVEL=info

LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b
LLM_API_KEY=

